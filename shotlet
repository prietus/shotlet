def rounded(cr, x, y, w, h, r):
    r = max(0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


def icon(kind, width=26, height=20):
    """The toolbar icons, drawn in the colour of the text around them."""
    area = Gtk.DrawingArea(content_width=width, content_height=height)

    def draw(a, cr, w, h):
        c = a.get_color()
        cr.set_source_rgba(c.red, c.green, c.blue, c.alpha)
        cr.set_line_width(1.6)
        cr.set_line_cap(1)
        cr.set_line_join(1)
        base = kind.replace("rec-", "")
        x, y, bw, bh = 2.8, 2.8, w - 5.6, h - 5.6
        if base == "screen":
            rounded(cr, x, y, bw, bh, 3)
            cr.stroke()
            rounded(cr, x + 2.6, y + 2.6, bw - 5.2, bh - 5.2, 1.2)
            cr.fill()
        elif base == "window":
            rounded(cr, x, y, bw, bh, 3)
            cr.stroke()
            cr.move_to(x, y + 4.6)
            cr.line_to(x + bw, y + 4.6)
            cr.stroke()
            for i in range(2):
                cr.arc(x + 2.9 + i * 2.8, y + 2.4, 0.75, 0, 2 * math.pi)
                cr.fill()
        elif base == "region":
            cr.set_dash([2.6, 2.9])
            rounded(cr, x, y, bw, bh, 3)
            cr.stroke()
            cr.set_dash([])
        elif kind == "close":
            cr.set_line_width(1.7)
            m = 5
            cr.move_to(m, m); cr.line_to(w - m, h - m)
            cr.move_to(w - m, m); cr.line_to(m, h - m)
            cr.stroke()
        elif kind == "chevron":
            cr.move_to(2.5, h / 2 - 1.5)
            cr.line_to(w / 2, h / 2 + 2)
            cr.line_to(w - 2.5, h / 2 - 1.5)
            cr.stroke()
        elif kind == "check":
            cr.set_line_width(1.8)
            cr.move_to(3, h / 2 + 0.5)
            cr.line_to(w / 2 - 1, h - 4)
            cr.line_to(w - 3, 4)
            cr.stroke()
        if kind.startswith("rec-"):
            # the record dot, cut out of the corner of the shape
            cx, cy = w - 5.2, h - 5.2
            cr.save()
            cr.set_operator(0)   # CLEAR
            cr.arc(cx, cy, 5.6, 0, 2 * math.pi)
            cr.fill()
            cr.restore()
            cr.arc(cx, cy, 3.4, 0, 2 * math.pi)
            cr.fill()

    area.set_draw_func(draw)
    return area


