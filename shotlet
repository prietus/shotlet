# The overlay of one monitor: the dimmed screen, the selection, the toolbar

class Overlay(Gtk.ApplicationWindow):
    HANDLE = 12   # how close to an edge of the selection counts as grabbing it

    def __init__(self, app, monitor, with_bar):
        super().__init__(application=app)
        self.app = app
        self.monitor = monitor
        self.connector = monitor.get_connector() or ""
        geo = monitor.get_geometry()
        self.origin = (geo.x, geo.y)
        self.size = (geo.width, geo.height)
        self.add_css_class("shotlet")

        Layer.init_for_window(self)
        Layer.set_namespace(self, "shotlet")
        Layer.set_monitor(self, monitor)
        Layer.set_layer(self, Layer.Layer.OVERLAY)
        for edge in (Layer.Edge.TOP, Layer.Edge.BOTTOM, Layer.Edge.LEFT, Layer.Edge.RIGHT):
            Layer.set_anchor(self, edge, True)
        Layer.set_exclusive_zone(self, -1)      # over the bar too
        Layer.set_keyboard_mode(self, Layer.KeyboardMode.EXCLUSIVE if with_bar else Layer.KeyboardMode.NONE)

        self.pointer = None        # pointer position, or None when it is elsewhere
        self.sel = None            # region: [x, y, w, h]
        self.drag = None           # (kind, selection at press, press point)
        self.hl = None             # highlight as drawn (it glides to hl_target)
        self.hl_target = None
        self.hl_alpha = 0.0
        self.fade = 0.0            # 0..1, the dim fading in and out
        self.closing = False
        self.last_frame = None
        self.ticking = False

        self.canvas = Gtk.DrawingArea(hexpand=True, vexpand=True)
        self.canvas.set_draw_func(self.draw)
        motion = Gtk.EventControllerMotion()
        motion.connect("motion", self.on_motion)
        motion.connect("enter", self.on_motion)
        motion.connect("leave", self.on_leave)
        self.canvas.add_controller(motion)
        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", self.on_drag_begin)
        drag.connect("drag-update", self.on_drag_update)
        drag.connect("drag-end", self.on_drag_end)
        self.canvas.add_controller(drag)
        click = Gtk.GestureClick(button=0)
        click.connect("released", self.on_click)
        self.canvas.add_controller(click)

        stack = Gtk.Overlay(child=self.canvas)
        self.bar = None
        if with_bar:
            self.bar = self.build_bar()
            stack.add_overlay(self.bar)
        self.set_child(stack)

        keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        last = app.cfg["last_region"]
        if app.cfg["remember"] and last and last.get("output") == self.connector:
            x, y, w, h = last["rect"]
            if w >= 8 and h >= 8 and x + w <= self.size[0] and y + h <= self.size[1]:
                self.sel = [x, y, w, h]

    # -- toolbar ------------------------------------------------------------

    def build_bar(self):
        bar = Gtk.Box(spacing=2, halign=Gtk.Align.CENTER, valign=Gtk.Align.END)
        bar.add_css_class("shotlet-bar")
        bar.set_margin_bottom(24)

        close = Gtk.Button(child=icon("close", 16, 16), tooltip_text="Close (Esc)")
        close.add_css_class("close")
        close.connect("clicked", lambda *_: self.app.close())
        bar.append(close)
        bar.append(self.separator())

        tips = {
            "screen": "Capture Entire Screen", "window": "Capture Selected Window",
            "region": "Capture Selected Portion", "rec-screen": "Record Entire Screen",
            "rec-region": "Record Selected Portion",
        }
        self.mode_buttons = {}
        group = None
        for i, mode in enumerate(MODES):
            if mode == "rec-screen":
                bar.append(self.separator())
            b = Gtk.ToggleButton(child=icon(mode), tooltip_text="%s (%d)" % (tips[mode], i + 1))
            b.add_css_class("mode")
            if group:
                b.set_group(group)
            group = group or b
            b.set_active(mode == self.app.mode)
            b.connect("toggled", lambda btn, m=mode: btn.get_active() and self.app.set_mode(m))
            self.mode_buttons[mode] = b
            bar.append(b)
        bar.append(self.separator())

        label = Gtk.Box(spacing=6)
        label.append(Gtk.Label(label="Options"))
        label.set_tooltip_text("Options (O)")
        label.append(icon("chevron", 10, 10))
        self.options = Gtk.MenuButton(child=label, direction=Gtk.ArrowType.UP)
        self.options.get_first_child().add_css_class("options")
        self.popover = Gtk.Popover(has_arrow=False, position=Gtk.PositionType.TOP)
        self.popover.add_css_class("shotlet-menu")
        self.popover.set_offset(0, -8)
        self.options.set_popover(self.popover)
        self.fill_menu()
        bar.append(self.options)

        self.primary = Gtk.Button()
        self.primary.add_css_class("primary")
        self.primary.connect("clicked", lambda *_: self.app.shoot_default())
        self.primary.set_margin_start(4)
        bar.append(self.primary)
        self.update_primary()
        for b in [close, self.primary, self.options.get_first_child(), *self.mode_buttons.values()]:
            b.set_focusable(False)
        return bar

    @staticmethod
    def separator():
        s = Gtk.Box()
        s.add_css_class("sep")
        return s

    def update_primary(self):
        if not getattr(self, "primary", None):
            return
        video = self.app.mode.startswith("rec-")
        self.primary.set_label("Record" if video else "Capture")
        (self.primary.add_css_class if video else self.primary.remove_css_class)("record")

    def fill_menu(self):
        cfg = self.app.cfg
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        def heading(text):
            l = Gtk.Label(label=text, xalign=0)
            l.add_css_class("heading")
            box.append(l)

        def rule():
            r = Gtk.Box()
            r.add_css_class("rule")
            box.append(r)

        def item(text, checked, action):
            row = Gtk.Box(spacing=6)
            mark = icon("check", 12, 12)
            mark.set_opacity(1 if checked else 0)
            mark.set_valign(Gtk.Align.CENTER)
            row.append(mark)
            row.append(Gtk.Label(label=text, xalign=0))
            b = Gtk.Button(child=row)

            def clicked(*_):
                action()
                save_config(cfg)
                self.popover.popdown()
                self.fill_menu()
            b.connect("clicked", clicked)
            box.append(b)

        def choose(key, value):
            return lambda: cfg.__setitem__(key, value)

        def toggle(key):
            return lambda: cfg.__setitem__(key, not cfg[key])

        heading("Save to")
        item("Screenshots Folder", cfg["save_to"] == "folder", choose("save_to", "folder"))
        item("Desktop", cfg["save_to"] == "desktop", choose("save_to", "desktop"))
        item("Clipboard", cfg["save_to"] == "clipboard", choose("save_to", "clipboard"))
        rule()
        heading("Timer")
        item("None", cfg["timer"] == 0, choose("timer", 0))
        item("5 Seconds", cfg["timer"] == 5, choose("timer", 5))
        item("10 Seconds", cfg["timer"] == 10, choose("timer", 10))
        rule()
        heading("Options")
        item("Show Floating Thumbnail", cfg["thumbnail"], toggle("thumbnail"))
        item("Remember Last Selection", cfg["remember"], toggle("remember"))
        item("Show Mouse Pointer", cfg["pointer"], toggle("pointer"))
        item("Copy Screenshots to Clipboard", cfg["clipboard"], toggle("clipboard"))
        item("Record Audio", cfg["audio"], toggle("audio"))
        self.popover.set_child(box)

    # -- animation ------------------------------------------------------------

    def appear(self):
        self.present()
        if self.bar:
            GLib.timeout_add(30, lambda: self.bar.add_css_class("shown") and False)
        self.animate()

    def disappear(self):
        self.closing = True
        if self.bar:
            self.popover.popdown()
            self.bar.add_css_class("leaving")
            self.bar.remove_css_class("shown")
        self.animate()

    def animate(self):
        if not self.ticking:
            self.ticking = True
            self.last_frame = None
            self.canvas.add_tick_callback(self.tick)

    def tick(self, widget, clock):
        now = clock.get_frame_time() / 1e6
        dt = min(0.05, now - self.last_frame) if self.last_frame else 0.016
        self.last_frame = now
        busy = False

        goal = 0.0 if self.closing else 1.0
        if self.fade != goal:
            step = dt / (0.13 if self.closing else 0.18)
            self.fade = max(0.0, self.fade - step) if self.closing else min(1.0, self.fade + step)
            busy = True

        # the highlight glides from one window to the next
        want = 1.0 if self.hl_target else 0.0
        if self.hl_alpha != want:
            self.hl_alpha += max(-dt / 0.12, min(dt / 0.12, want - self.hl_alpha))
            busy = True
        if self.hl_target:
            if self.hl is None or self.hl_alpha < 0.15:
                self.hl = list(self.hl_target)
            k = 1 - math.exp(-dt * 22)
            for i in range(4):
                d = self.hl_target[i] - self.hl[i]
                if abs(d) > 0.4:
                    self.hl[i] += d * k
                    busy = True
                else:
                    self.hl[i] = self.hl_target[i]
        elif self.hl_alpha == 0:
            self.hl = None

        self.canvas.queue_draw()
        self.ticking = busy
        return busy

    # -- drawing ------------------------------------------------------------

    def draw(self, area, cr, w, h):
        mode = self.app.mode
        base = mode.replace("rec-", "")
        accent = RECORD if mode.startswith("rec-") else ACCENT
        f = self.fade

        if base == "region":
            cr.set_source_rgba(0, 0, 0, DIM * f)
            cr.set_fill_rule(1)   # EVEN_ODD
            cr.rectangle(0, 0, w, h)
            if self.sel:
                x, y, sw, sh = self.sel
                cr.rectangle(x, y, sw, sh)
            cr.fill()
            if self.sel:
                self.draw_selection(cr, accent, f, w, h)
            else:
                self.draw_hint(cr, "Drag to select an area", w, h, f)
            return

        # screen and window: everything dimmed but what would be captured
        hole = self.hl if self.hl and self.hl_alpha > 0 else None
        a = self.hl_alpha if hole else 0
        radius = 0 if base == "screen" else 6
        cr.set_fill_rule(1)
        cr.set_source_rgba(0, 0, 0, (0.18 if base == "screen" else DIM) * f)
        cr.rectangle(0, 0, w, h)
        if hole and a >= 1:
            rounded(cr, *hole, radius)
        cr.fill()
        if hole:
            if a < 1:   # fading: lighten the hole instead of cutting it
                cr.set_source_rgba(0, 0, 0, 0)
            cr.set_source_rgba(*accent, 0.10 * a * f)
            rounded(cr, *hole, radius)
            cr.fill()
            inset = 1.5
            cr.set_source_rgba(*accent, 0.95 * a * f)
            cr.set_line_width(3)
            rounded(cr, hole[0] + inset, hole[1] + inset, hole[2] - 2 * inset, hole[3] - 2 * inset, radius)
            cr.stroke()
        elif base == "window" and not self.app.windows:
            self.draw_hint(cr, "No windows here", w, h, f)

    def draw_selection(self, cr, accent, f, w, h):
        x, y, sw, sh = self.sel
        cr.set_fill_rule(0)
        cr.set_source_rgba(1, 1, 1, 0.9 * f)
        cr.set_line_width(1)
        cr.rectangle(x + 0.5, y + 0.5, sw - 1, sh - 1)
        cr.stroke()
        cr.set_source_rgba(*accent, f)
        cr.set_dash([6, 6])
        cr.rectangle(x + 0.5, y + 0.5, sw - 1, sh - 1)
        cr.stroke()
        cr.set_dash([])
        # handles
        for hx, hy in self.handle_points():
            cr.arc(hx, hy, 5, 0, 2 * math.pi)
            cr.set_source_rgba(1, 1, 1, f)
            cr.fill_preserve()
            cr.set_source_rgba(0, 0, 0, 0.35 * f)
            cr.set_line_width(1)
            cr.stroke()
        # size
        scale = self.monitor.get_scale() if hasattr(self.monitor, "get_scale") else self.monitor.get_scale_factor()
        text = "%d × %d" % (round(sw * scale), round(sh * scale))
        layout = self.canvas.create_pango_layout(text)
        layout.set_font_description(Pango.FontDescription("Inter Medium 9"))
        tw, th = layout.get_pixel_size()
        bx = x + sw / 2 - tw / 2 - 8
        by = y + sh + 10
        if by + th + 8 > h - 4:
            by = y + sh - th - 18
        bx = max(4, min(w - tw - 20, bx))
        cr.set_source_rgba(0.118, 0.118, 0.18, 0.9 * f)
        rounded(cr, bx, by, tw + 16, th + 8, (th + 8) / 2)
        cr.fill()
        cr.set_source_rgba(0.804, 0.839, 0.957, f)
        cr.move_to(bx + 8, by + 4)
        PangoCairo.show_layout(cr, layout)

    def draw_hint(self, cr, text, w, h, f):
        layout = self.canvas.create_pango_layout(text)
        layout.set_font_description(Pango.FontDescription("Inter Medium 11"))
        tw, th = layout.get_pixel_size()
        bx, by = (w - tw) / 2 - 14, (h - th) / 2 - 8
        cr.set_fill_rule(0)
        cr.set_source_rgba(0.118, 0.118, 0.18, 0.85 * f)
        rounded(cr, bx, by, tw + 28, th + 16, (th + 16) / 2)
        cr.fill()
        cr.set_source_rgba(0.804, 0.839, 0.957, f)
        cr.move_to(bx + 14, by + 8)
        PangoCairo.show_layout(cr, layout)

    # -- pointer ------------------------------------------------------------

    def handle_points(self):
        x, y, w, h = self.sel
        return [(x + w * i / 2, y + h * j / 2) for j in range(3) for i in range(3) if (i, j) != (1, 1)]

    def hit(self, px, py):
        """What a press at this point does to the selection."""
        if not self.sel:
            return "new"
        x, y, w, h = self.sel
        m = self.HANDLE
        if not (x - m <= px <= x + w + m and y - m <= py <= y + h + m):
            return "new"
        horiz = "w" if abs(px - x) <= m else "e" if abs(px - x - w) <= m else ""
        vert = "n" if abs(py - y) <= m else "s" if abs(py - y - h) <= m else ""
        return (vert + horiz) or "move"

    CURSORS = {"new": "crosshair", "move": "move", "n": "ns-resize", "s": "ns-resize", "e": "ew-resize",
               "w": "ew-resize", "nw": "nwse-resize", "se": "nwse-resize", "ne": "nesw-resize", "sw": "nesw-resize"}

    def window_at(self, px, py):
        gx, gy = px + self.origin[0], py + self.origin[1]
        for win in self.app.windows:      # topmost first
            if win["x"] <= gx < win["x"] + win["width"] and win["y"] <= gy < win["y"] + win["height"]:
                return win
        return None

    def local_rect(self, win):
        return [win["x"] - self.origin[0], win["y"] - self.origin[1], win["width"], win["height"]]

    def refresh_hover(self):
        """Recompute what is highlighted (after a motion or a mode change)."""
        base = self.app.mode.replace("rec-", "")
        target = None
        cursor = "default"
        if base == "region":
            if self.pointer and not self.drag:
                cursor = self.CURSORS[self.hit(*self.pointer)]
            elif self.drag:
                cursor = self.CURSORS[self.drag[0]]
        elif self.pointer:
            if base == "screen":
                target = [0, 0, self.size[0], self.size[1]]
            else:
                win = self.window_at(*self.pointer)
                target = self.local_rect(win) if win else None
            cursor = "pointer" if target else "default"
        self.canvas.set_cursor(Gdk.Cursor.new_from_name(cursor))
        if target != self.hl_target:
            self.hl_target = target
            self.animate()
        self.canvas.queue_draw()

    def on_motion(self, _c, x, y):
        self.pointer = (x, y)
        self.refresh_hover()

    def on_leave(self, _c):
        self.pointer = None
        self.refresh_hover()

    def on_drag_begin(self, gesture, x, y):
        if self.app.mode.replace("rec-", "") != "region":
            return
        kind = self.hit(x, y)
        if kind == "new":
            self.app.clear_selections(keep=self)
            self.sel = [x, y, 0, 0]
        self.drag = (kind, list(self.sel), (x, y))
        self.refresh_hover()

    def on_drag_update(self, gesture, dx, dy):
        if not self.drag:
            return
        kind, (x, y, w, h), (px, py) = self.drag
        W, H = self.size
        if kind == "new":
            x2 = max(0, min(W, px + dx))
            y2 = max(0, min(H, py + dy))
            self.sel = [min(px, x2), min(py, y2), abs(x2 - px), abs(y2 - py)]
        elif kind == "move":
            self.sel = [max(0, min(W - w, x + dx)), max(0, min(H - h, y + dy)), w, h]
        else:
            left, top, right, bottom = x, y, x + w, y + h
            if "w" in kind:
                left = max(0, min(right - 8, left + dx))
            if "e" in kind:
                right = min(W, max(left + 8, right + dx))
            if "n" in kind:
                top = max(0, min(bottom - 8, top + dy))
            if "s" in kind:
                bottom = min(H, max(top + 8, bottom + dy))
            self.sel = [left, top, right - left, bottom - top]
        self.canvas.queue_draw()

    def on_drag_end(self, gesture, dx, dy):
        if not self.drag:
            return
        self.drag = None
        if self.sel:
            self.sel = [round(v) for v in self.sel]
            if self.sel[2] < 8 or self.sel[3] < 8:
                self.sel = None        # a click, not a drag
        self.refresh_hover()

    def on_click(self, gesture, n, x, y):
        button = gesture.get_current_button()
        if button == 3:
            self.app.close()
            return
        if button != 1:
            return
        base = self.app.mode.replace("rec-", "")
        if base == "screen":
            self.app.shoot(("output", self.connector, self))
        elif base == "window":
            win = self.window_at(x, y)
            if win:
                self.app.shoot(("window", win, self))
        elif n == 2 and self.sel and self.hit(x, y) == "move":
            self.app.shoot(("region", self.sel, self))

    def on_key(self, _c, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            self.app.close()
        elif keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_space):
            self.app.shoot_default()
        elif keyval in (Gdk.KEY_o, Gdk.KEY_O) and self.bar:
            self.options.popup()
        elif Gdk.KEY_1 <= keyval <= Gdk.KEY_5 and self.bar:
            self.mode_buttons[MODES[keyval - Gdk.KEY_1]].set_active(True)
        else:
            return False
        return True


