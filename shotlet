#!/usr/bin/env python3
"""shotlet: a macOS-style screenshot and screen recording toolbar for
river + rivermonad (or any wlroots compositor; window mode needs rivermonad).

  shotlet            open the toolbar (again: close it; while recording: stop)
  shotlet stop       stop the recording in progress
  shotlet MODE       open in a mode: screen window region rec-screen rec-region
  shotlet status     print "recording SECONDS" or "idle" (for status bars)

Depends on grim, wf-recorder, wl-clipboard, GTK 4, gtk4-layer-shell and
python-gobject; swappy (click on the thumbnail to annotate) and ffmpeg
(thumbnails of recordings) are optional.

Settings are changed from the Options menu and kept in
~/.config/shotlet/config.json; ~/.config/shotlet/style.css restyles it.
"""
import json
import math
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
import warnings

MODES = ["screen", "window", "region", "rec-screen", "rec-region"]
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
# Same state file as the old `screenrec` script, so either can stop the other.
REC_STATE = os.path.join(RUNTIME, "screenrec")
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "shotlet")
CONFIG_FILE = os.path.join(CONFIG_DIR, "config.json")
CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "shotlet")

DEFAULTS = {
    "mode": "region",
    "save_to": "folder",      # folder | desktop | clipboard
    "timer": 0,               # seconds: 0, 5 or 10
    "pointer": False,
    "clipboard": True,        # also copy screenshots saved to a file
    "audio": False,
    "remember": True,         # start from the last selected region
    "thumbnail": True,
    "last_region": None,      # {"output": name, "rect": [x, y, w, h]} (local to the output)
}


# ---------------------------------------------------------------------------
# Things that need no GUI

def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG_FILE) as f:
            cfg.update({k: v for k, v in json.load(f).items() if k in DEFAULTS})
    except (OSError, ValueError):
        pass
    if cfg["mode"] not in MODES:
        cfg["mode"] = DEFAULTS["mode"]
    return cfg


def save_config(cfg):
    try:
        os.makedirs(CONFIG_DIR, exist_ok=True)
        tmp = CONFIG_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(cfg, f, indent=2)
        os.replace(tmp, CONFIG_FILE)
    except OSError:
        pass


def notify(title, body="", icon=None):
    cmd = ["notify-send", "-a", "shotlet", title, body]
    if icon:
        cmd[3:3] = ["-i", icon]
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


def recording():
    """(pid, file, started) of the recording in progress, or None."""
    try:
        with open(REC_STATE) as f:
            lines = f.read().splitlines()
        pid = int(lines[0])
        os.kill(pid, 0)
        return pid, lines[1], os.stat(REC_STATE).st_mtime
    except (OSError, ValueError, IndexError):
        return None


def stop_recording():
    """Finish the recording; returns the file, or None if there was none."""
    rec = recording()
    if not rec:
        try:
            os.unlink(REC_STATE)       # stale
        except OSError:
            pass
        return None
    pid, path, _ = rec
    os.kill(pid, signal.SIGINT)        # wf-recorder finishes the file on SIGINT
    deadline = time.time() + 8
    while time.time() < deadline:
        try:
            os.kill(pid, 0)
        except OSError:
            break
        time.sleep(0.05)
    try:
        os.unlink(REC_STATE)
    except OSError:
        pass
    return path


def user_dir(name, fallback):
    try:
        out = subprocess.run(["xdg-user-dir", name], capture_output=True, text=True).stdout.strip()
        if out and out != os.path.expanduser("~"):
            return out
    except OSError:
        pass
    return os.path.expanduser(fallback)


def target_file(cfg, video):
    stamp = time.strftime("%Y-%m-%d_%H-%M-%S")
    if cfg["save_to"] == "desktop":
        d = user_dir("DESKTOP", "~/Desktop")
    elif video:
        d = os.path.join(user_dir("VIDEOS", "~/Videos"), "Recordings")
    elif cfg["save_to"] == "clipboard":
        d = CACHE_DIR
    else:
        d = os.path.join(user_dir("PICTURES", "~/Pictures"), "Screenshots")
    os.makedirs(d, exist_ok=True)
    return os.path.join(d, stamp + (".mp4" if video else ".png"))


def rivermonad_ipc(request, lines=1):
    """Send a request to rivermonad; returns the parsed reply lines."""
    path = os.path.join(RUNTIME, "rivermonad-%s.sock" % os.environ.get("WAYLAND_DISPLAY", "wayland-0").replace("/", "_"))
    if not os.path.exists(path):
        path = os.environ.get("RIVERMONAD_SOCKET", "")
    out = []
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(0.5)
            s.connect(path)
            s.sendall((json.dumps(request) + "\n").encode())
            buf = b""
            while buf.count(b"\n") < lines:
                chunk = s.recv(65536)
                if not chunk:
                    break
                buf += chunk
        for line in buf.split(b"\n")[:lines]:
            if line.strip():
                out.append(json.loads(line))
    except (OSError, ValueError):
        pass
    return out


def early_commands(argv):
    """Subcommands that must not pay for (or need) GTK. Returns the mode to
    open the toolbar in, or exits."""
    arg = argv[1] if len(argv) > 1 else None
    if arg in ("-h", "--help", "help"):
        print(__doc__.strip())
        sys.exit(0)
    if arg == "status":
        rec = recording()
        print("recording %d" % (time.time() - rec[2]) if rec else "idle")
        sys.exit(0)
    if arg not in (None, "stop") and arg not in MODES:
        print("shotlet: unknown command %r (try --help)" % arg, file=sys.stderr)
        sys.exit(2)
    if arg == "stop" or recording():
        path = stop_recording()
        if arg == "stop" and not path:
            sys.exit(0)
        return ("stopped", path)
    return ("open", arg)


ACTION = early_commands(sys.argv)
