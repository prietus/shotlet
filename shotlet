class Shotlet(Gtk.Application):
    def __init__(self, action):
        # A second `shotlet` talks to the one already open (and closes it).
        if action[0] == "open":
            super().__init__(application_id="dev.shotlet.Shotlet", flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        else:
            super().__init__(application_id=None, flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.action = action
        self.cfg = load_config()
        self.mode = self.cfg["mode"]
        self.overlays = []
        self.windows = []
        self.busy = False          # between the click and the end of the capture
        self.thumb = None
        self.started = False

    def do_startup(self):
        Gtk.Application.do_startup(self)
        display = Gdk.Display.get_default()
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS, -1) if Gtk.get_minor_version() >= 12 else provider.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_display(display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        user = os.path.join(CONFIG_DIR, "style.css")
        if os.path.exists(user):
            p = Gtk.CssProvider()
            p.load_from_path(user)
            Gtk.StyleContext.add_provider_for_display(display, p, Gtk.STYLE_PROVIDER_PRIORITY_USER)

    def do_command_line(self, cl):
        """Runs in the first instance, also for the later `shotlet` commands."""
        args = cl.get_arguments()[1:]
        if args and args[0] in MODES and not self.overlays:
            self.mode = self.cfg["mode"] = args[0]
        self.activate()
        return 0

    def do_activate(self):
        if self.action[0] == "stopped":
            if not self.started:
                self.started = True
                self.hold()
                self.finished(self.action[1], True, self.monitors()[0] if self.monitors() else None)
            return
        if self.overlays:
            self.close()           # run again while open: close
        elif not self.busy:
            if self.thumb and self.thumb.win:
                self.thumb.pause()
                self.thumb.close()
            self.open()
        self.started = True

    def monitors(self):
        mons = Gdk.Display.get_default().get_monitors()
        return [mons.get_item(i) for i in range(mons.get_n_items())]

    def open(self):
        mons = self.monitors()
        if not mons:
            return
        state = rivermonad_ipc("EventStream", lines=2)
        focused = None
        for line in state:
            focused = (line.get("State") or {}).get("focused_output") or focused
        reply = rivermonad_ipc("Windows")
        self.windows = reply[0].get("Windows", []) if reply and isinstance(reply[0], dict) else []
        main = next((m for m in mons if m.get_connector() == focused), mons[0])
        self.overlays = [Overlay(self, m, m is main) for m in mons]
        self.main = next(o for o in self.overlays if o.bar)
        for o in self.overlays:
            o.appear()

    def set_mode(self, mode):
        self.mode = mode
        self.cfg["mode"] = mode
        for o in self.overlays:
            o.hl = o.hl_target = None
            o.hl_alpha = 0.0
            o.update_primary()
            o.refresh_hover()

    def clear_selections(self, keep):
        for o in self.overlays:
            if o is not keep and o.sel:
                o.sel = None
                o.canvas.queue_draw()

    def close(self, then=None):
        """Animate the overlays away; `then` runs once they are off screen."""
        overlays, self.overlays = self.overlays, []
        save_config(self.cfg)
        for o in overlays:
            o.disappear()

        def gone():
            for o in overlays:
                o.destroy()
            if then:
                GLib.timeout_add(130, lambda: then() and False)
            return False
        GLib.timeout_add(170, gone)

    def shoot_default(self):
        """The Capture button and Enter."""
        base = self.mode.replace("rec-", "")
        if base == "screen":
            o = next((o for o in self.overlays if o.pointer), self.main)
            self.shoot(("output", o.connector, o))
        elif base == "window":
            for o in self.overlays:
                if o.hl_target and o.pointer:
                    win = o.window_at(*o.pointer)
                    if win:
                        return self.shoot(("window", win, o))
            win = next((w for w in self.windows if w.get("focused")), None)
            if win:
                o = next((o for o in self.overlays if o.connector == win.get("output")), self.main)
                self.shoot(("window", win, o))
        else:
            o = next((o for o in self.overlays if o.sel), None)
            if o:
                self.shoot(("region", o.sel, o))

    def shoot(self, target):
        if self.busy:
            return
        self.busy = True
        self.hold()
        kind, what, overlay = target
        video = self.mode.startswith("rec-")
        monitor = overlay.monitor
        ox, oy = overlay.origin
        scale = monitor.get_scale() if hasattr(monitor, "get_scale") else monitor.get_scale_factor()
        if kind == "region":
            self.cfg["last_region"] = {"output": overlay.connector, "rect": [int(v) for v in what]}
            geometry = "%d,%d %dx%d" % (what[0] + ox, what[1] + oy, what[2], what[3])
        elif kind == "window":
            geometry = "%d,%d %dx%d" % (what["x"], what["y"], what["width"], what["height"])

        path = target_file(self.cfg, video)
        if video:
            cmd = ["wf-recorder", "-f", path]
            cmd += ["-o", what] if kind == "output" else ["-g", geometry]
            if self.cfg["audio"]:
                cmd.append("-a")
        else:
            cmd = ["grim"]
            if self.cfg["pointer"]:
                cmd.append("-c")
            if kind == "output":
                cmd += ["-o", what]
            elif kind == "window" and what.get("id"):
                # the window itself, even where something covers it
                cmd += ["-s", "%g" % scale, "-T", what["id"]]
            else:
                cmd += ["-g", geometry]
            cmd.append(path)
        fallback = None
        if not video and kind == "window":
            fallback = ["grim"] + (["-c"] if self.cfg["pointer"] else []) + ["-g", geometry, path]

        def go():
            if video:
                self.record(cmd, path)
            else:
                self.capture(cmd, fallback, path, monitor)

        def after_close():
            if self.cfg["timer"] > 0:
                Countdown(self, monitor, self.cfg["timer"], video, lambda ok: go() if ok else self.done())
            else:
                go()
        self.close(after_close)

    def capture(self, cmd, fallback, path, monitor):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=20)
            if r.returncode != 0 and fallback:
                r = subprocess.run(fallback, capture_output=True, text=True, timeout=20)
            err = r.stderr.strip() if r.returncode != 0 else None
        except (OSError, subprocess.SubprocessError) as e:
            err = str(e)
        if err or not os.path.exists(path):
            notify("Screenshot failed", err or "grim wrote nothing")
            return self.done()
        if self.cfg["clipboard"] or self.cfg["save_to"] == "clipboard":
            try:
                with open(path, "rb") as f:
                    subprocess.Popen(["wl-copy", "--type", "image/png"], stdin=f)
            except OSError:
                pass
        self.finished(path, False, monitor)

    def record(self, cmd, path):
        try:
            proc = subprocess.Popen(cmd, start_new_session=True, stdin=subprocess.DEVNULL,
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError as e:
            notify("Recording failed", str(e))
            return self.done()
        with open(REC_STATE, "w") as f:
            f.write("%d\n%s\n" % (proc.pid, path))

        def check():
            if proc.poll() is not None:
                try:
                    os.unlink(REC_STATE)
                except OSError:
                    pass
                notify("Recording failed", "wf-recorder exited (code %s)" % proc.returncode)
            self.done()
            return False
        GLib.timeout_add(600, check)

    def finished(self, path, video, monitor):
        """A screenshot was taken or a recording stopped: show it."""
        if not path or not os.path.exists(path):
            notify("Recording failed", "nothing was saved")
            return self.done()
        if self.cfg["thumbnail"]:
            self.thumb = Thumbnail(self, monitor, path, video)
            self.busy = False       # the toolbar can be opened again meanwhile
        else:
            thumb = path if not video else None
            notify("Recording saved" if video else "Screenshot saved", Thumbnail.pretty(type("P", (), {"path": path})()), thumb)
            self.done()

    def done(self):
        self.busy = False
        self.release()


if __name__ == "__main__":
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    sys.exit(Shotlet(ACTION).run(sys.argv if ACTION[0] == "open" else [sys.argv[0]]))
