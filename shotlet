# Small floating windows: the countdown and the thumbnail

def small_layer_window(app, monitor, edges, keyboard=False):
    win = Gtk.ApplicationWindow(application=app)
    win.add_css_class("shotlet")
    Layer.init_for_window(win)
    Layer.set_namespace(win, "shotlet")
    if monitor:
        Layer.set_monitor(win, monitor)
    Layer.set_layer(win, Layer.Layer.OVERLAY)
    for e in edges:
        Layer.set_anchor(win, e, True)
    Layer.set_keyboard_mode(win, Layer.KeyboardMode.ON_DEMAND if keyboard else Layer.KeyboardMode.NONE)
    return win


class Countdown:
    """The timer: a pill where the toolbar was. Everything else stays usable,
    so menus can be opened before the shot."""

    def __init__(self, app, monitor, seconds, video, done):
        self.app, self.left, self.done = app, seconds, done
        self.win = small_layer_window(app, monitor, [Layer.Edge.BOTTOM])
        pill = Gtk.Box(spacing=4, halign=Gtk.Align.CENTER)
        pill.add_css_class("shotlet-pill")
        pill.set_margin_bottom(24)
        self.count = Gtk.Label(label=str(seconds), width_chars=2)
        self.count.add_css_class("count")
        what = Gtk.Label(label="Recording starts…" if video else "Taking screenshot…")
        what.add_css_class("what")
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: self.finish(False))
        for wdg in (self.count, what, cancel):
            pill.append(wdg)
        self.pill = pill
        self.win.set_child(pill)
        self.win.present()
        GLib.timeout_add(30, lambda: pill.add_css_class("shown") and False)
        self.source = GLib.timeout_add(1000, self.tick)

    def tick(self):
        self.left -= 1
        if self.left <= 0:
            self.source = None
            self.finish(True)
            return False
        self.count.set_label(str(self.left))
        return True

    def finish(self, ok):
        if self.source:
            GLib.source_remove(self.source)
            self.source = None
        self.pill.add_css_class("leaving")
        self.pill.remove_css_class("shown")

        def gone():
            self.win.destroy()
            # give the compositor a frame to take the pill off the screen
            GLib.timeout_add(120, lambda: self.done(ok) and False)
            return False
        GLib.timeout_add(170, gone)


class Thumbnail:
    """The result, floating in the corner for a few seconds. Click: annotate
    it in swappy (a recording: play it). Right click: dismiss."""

    WIDTH = 200

    def __init__(self, app, monitor, path, video):
        self.app, self.path, self.video = app, path, video
        self.timeout = None
        image = path
        if video:
            image = os.path.join(CACHE_DIR, "thumb.png")
            os.makedirs(CACHE_DIR, exist_ok=True)
            try:
                subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", path, "-frames:v", "1", "-vf",
                                "scale=%d:-1" % (self.WIDTH * 2), image], timeout=10, check=True)
            except (OSError, subprocess.SubprocessError):
                image = None
        pixbuf = None
        if image:
            try:
                # twice the size on screen is plenty, also on HiDPI outputs
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(image, self.WIDTH * 2, -1, True)
            except GLib.Error:
                pass
        if not pixbuf:
            notify("Recording saved" if video else "Screenshot saved", self.pretty())
            GLib.idle_add(app.done)
            return

        ratio = pixbuf.get_height() / max(1, pixbuf.get_width())
        height = int(max(48, min(150, self.WIDTH * ratio)))
        width = int(max(72, min(self.WIDTH, height / ratio)))
        picture = Gtk.DrawingArea(content_width=width, content_height=height)

        def draw(area, cr, w, h):      # scaled to cover the card
            k = max(w / pixbuf.get_width(), h / pixbuf.get_height())
            cr.translate((w - pixbuf.get_width() * k) / 2, (h - pixbuf.get_height() * k) / 2)
            cr.scale(k, k)
            Gdk.cairo_set_source_pixbuf(cr, pixbuf, 0, 0)
            cr.paint()
        picture.set_draw_func(draw)
        card = Gtk.Overlay(child=picture, halign=Gtk.Align.END, valign=Gtk.Align.END)
        card.set_overflow(Gtk.Overflow.HIDDEN)
        card.add_css_class("shotlet-thumb")
        card.set_cursor(Gdk.Cursor.new_from_name("pointer"))
        card.set_tooltip_text(("Click to play · " if video else "Click to annotate · ") + self.pretty())
        if video:
            badge = Gtk.DrawingArea(content_width=34, content_height=34, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
            badge.set_draw_func(self.draw_play)
            card.add_overlay(badge)
        self.card = card

        click = Gtk.GestureClick(button=0)
        click.connect("released", self.on_click)
        card.add_controller(click)
        hover = Gtk.EventControllerMotion()
        hover.connect("enter", lambda *_: self.pause())
        hover.connect("leave", lambda *_: self.arm(2500))
        card.add_controller(hover)

        self.win = small_layer_window(app, monitor, [Layer.Edge.BOTTOM, Layer.Edge.RIGHT])
        self.win.set_child(card)
        self.win.present()
        GLib.timeout_add(40, lambda: card.add_css_class("shown") and False)
        self.arm(5000)

    def pretty(self):
        if self.path.startswith(CACHE_DIR):
            return "Copied to the clipboard"
        home = os.path.expanduser("~")
        return "~" + self.path[len(home):] if self.path.startswith(home) else self.path

    @staticmethod
    def draw_play(area, cr, w, h):
        cr.arc(w / 2, h / 2, w / 2 - 1, 0, 2 * math.pi)
        cr.set_source_rgba(0.118, 0.118, 0.18, 0.8)
        cr.fill()
        cr.set_source_rgba(1, 1, 1, 0.95)
        cr.move_to(w * 0.40, h * 0.30)
        cr.line_to(w * 0.72, h * 0.50)
        cr.line_to(w * 0.40, h * 0.70)
        cr.close_path()
        cr.fill()

    def pause(self):
        if self.timeout:
            GLib.source_remove(self.timeout)
            self.timeout = None

    def arm(self, ms):
        self.pause()
        self.timeout = GLib.timeout_add(ms, self.leave)

    def leave(self):
        self.timeout = None
        self.card.add_css_class("leaving")
        self.card.remove_css_class("shown")
        GLib.timeout_add(300, self.close)
        return False

    def close(self):
        if self.win:
            self.win.destroy()
            self.win = None
            self.app.done()
        return False

    def on_click(self, gesture, n, x, y):
        if gesture.get_current_button() == 1:
            if self.video:
                cmd = ["xdg-open", self.path]
            elif shutil.which("swappy"):
                cmd = ["swappy", "-f", self.path, "-o", self.path]
            else:
                cmd = ["xdg-open", self.path]
            try:
                subprocess.Popen(cmd, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                pass
        self.pause()
        self.leave()


